# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/achat
REDIS_URL=redis://localhost:6379

# Sign-in is an email and a password. The password is stored hashed in the User
# table; the email identifies the account and is stored as you enter it. No
# email provider is involved, so there are no mail credentials to configure.

# Optional: restrict who can sign up. Without it, anyone who reaches your
# public URL can create an account and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Meta / Instagram
# v26.0 is current (released 2026-07-29). Pin this so a Meta-side default bump
# never silently changes response shapes under us.
META_GRAPH_API_VERSION=v26.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Facebook Login (Pages + Page-linked Instagram). Separate from
# INSTAGRAM_APP_ID/INSTAGRAM_APP_SECRET on purpose: a Meta app can back both
# products, but Instagram-with-Instagram-Login is a different product with a
# different permission review. Pointing one flow at the other grants the wrong
# scopes. Required by /api/meta/connect.
META_APP_ID=your-facebook-login-app-id
META_APP_SECRET=your-facebook-login-app-secret
# Set to 1 to request the WhatsApp scopes during the same consent screen.
# Leave unset unless the workspace has Business Manager access; requesting these
# without it makes Meta reject the whole authorization request.
META_WHATSAPP_SCOPES=
# Set to 1 to force auth_type=reauthenticate, which re-prompts for permissions
# the user previously declined. Leave unset for a normal consent screen.
META_FORCE_REAUTHENTICATE=
# Facebook Login for Business: paste the Configuration ID from
# App Dashboard > Facebook Login for Business > Configurations. When set it
# REPLACES the scope list in the login dialog, because that configuration is
# what App Review reviews. Leave empty only while still on classic Facebook Login.
META_LOGIN_CONFIG_ID=
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
